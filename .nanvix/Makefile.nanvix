# Copyright(c) The Maintainers of Nanvix.
# Licensed under the MIT License.
#
# Usage: make -f .nanvix/Makefile.nanvix PLATFORM=<platform> PROCESS_MODE=<mode> \
#    MEMORY_SIZE=<size> NANVIX_HOME=<home> NANVIX_BUILDROOT=<buildroot> \
#    NANVIX_TOOLCHAIN=<toolchain> [target]
#
# Targets:
#   all              Build libxslt.a, libexslt.a, and the test ELF, then stage via install
#   install          Stage built artifacts into LIB_OUT/INCLUDE_OUT/TEST_OUT
#   test             Verify functional-test prerequisites (build artifacts).
#                    The runtime execution is driven by z.py on the host.
#   clean            Remove build artifacts

# ===========================================================================
# Global Variables
# ===========================================================================

# Some assumptions:
# 1. This makefile is expected to be invoked via z.py.
# 2. Build goals (all, install) require the Nanvix SDK at
#    $(NANVIX_TOOLCHAIN); other goals (test-*, clean) are pure host-side.
# 3. Build ALWAYS runs before test and release.
# 4. Release packaging is handled by the inherited ZScript.release(), which
#    packages release_dir() (= .nanvix/out/release/) into dist_dir();
#    the install target below stages artifacts into that tree.

.DEFAULT_GOAL=all
EXE = .elf

STATICLIB_XSLT  := libxslt/.libs/libxslt.a
STATICLIB_EXSLT := libexslt/.libs/libexslt.a
TEST_SRC        := .nanvix/test/test_libxslt.c
TEST_ELF        := test_libxslt$(EXE)

_NANVIX_DOCKER_BUILD_GOALS := all install $(STATICLIB_XSLT) $(STATICLIB_EXSLT) $(TEST_ELF)
_NANVIX_GOALS := $(or $(MAKECMDGOALS),$(.DEFAULT_GOAL))

# Ensure required variables are defined.
_REQUIRED := PLATFORM \
    PROCESS_MODE \
    MEMORY_SIZE \
    NANVIX_HOME \
    NANVIX_BUILDROOT \
    NANVIX_TOOLCHAIN \
    NANVIX_ROOT \
    OUT_DIR \
    DIST_DIR \
    LIB_OUT \
    INCLUDE_OUT \
    BIN_OUT \
    TEST_OUT
ifneq ($(filter-out clean,$(_NANVIX_GOALS)),)
  $(foreach v,$(_REQUIRED),\
    $(if $($v),,$(error Required variable $v not set))\
  )
endif

SYSROOT_PATH   := $(abspath $(NANVIX_HOME))
BUILDROOT_PATH := $(abspath $(NANVIX_BUILDROOT))
NPROC := $(shell nproc 2>/dev/null || echo 4)

# ===========================================================================
# Build Mode Variables
# ===========================================================================

_BUILD := $(filter $(_NANVIX_DOCKER_BUILD_GOALS),$(_NANVIX_GOALS))
_NONBUILD := $(filter-out $(_NANVIX_DOCKER_BUILD_GOALS),$(_NANVIX_GOALS))
ifneq ($(_BUILD),)
  ifneq ($(_NONBUILD),)
    $(error Cannot mix build and non-build targets. Build targets: $(_NANVIX_DOCKER_BUILD_GOALS))
  endif

  ifeq ($(wildcard $(NANVIX_TOOLCHAIN)/nanvix-sdk.json),)
    $(error Nanvix SDK not found at $(NANVIX_TOOLCHAIN))
  endif
  ifeq ($(wildcard $(NANVIX_TOOLCHAIN)/bin/clang),)
    $(error Nanvix SDK Clang not found at $(NANVIX_TOOLCHAIN)/bin/clang)
  endif
endif

CC     := $(NANVIX_TOOLCHAIN)/bin/clang
AR     := $(NANVIX_TOOLCHAIN)/bin/llvm-ar
RANLIB := $(NANVIX_TOOLCHAIN)/bin/llvm-ranlib
NM     := $(NANVIX_TOOLCHAIN)/bin/llvm-nm
STRIP  := $(NANVIX_TOOLCHAIN)/bin/llvm-strip

# ===========================================================================
# Build Targets
# ===========================================================================

all: $(STATICLIB_XSLT) $(STATICLIB_EXSLT) $(TEST_ELF) install

$(STATICLIB_XSLT) $(STATICLIB_EXSLT):
	sh -c '\
	  export PATH="$(NANVIX_TOOLCHAIN)/bin:$$PATH" && \
	  touch aclocal.m4 configure config.h.in Makefile.in libxslt/Makefile.in libexslt/Makefile.in && \
	  ./configure --host=i686-nanvix \
	    --prefix="$(BUILDROOT_PATH)" \
	    --enable-static --disable-shared --disable-maintainer-mode \
	    --without-python --without-crypto \
	    --without-debugger --without-plugins \
	    --with-libxml-prefix="$(BUILDROOT_PATH)" \
	    --with-libxml-include-prefix="$(BUILDROOT_PATH)/include/libxml2" \
	    --with-libxml-libs-prefix="$(BUILDROOT_PATH)/lib" \
	    CC="$(CC)" AR="$(AR)" RANLIB="$(RANLIB)" NM="$(NM)" STRIP="$(STRIP)" \
	    CFLAGS="-I$(BUILDROOT_PATH)/include -I$(BUILDROOT_PATH)/include/libxml2" \
	    LDFLAGS="-L$(BUILDROOT_PATH)/lib" \
	    LIBS="-lxml2 -lz" && \
	  make -C libxslt -j$(NPROC) && \
	  make -C libexslt -j$(NPROC)'

$(TEST_ELF): $(TEST_SRC)
	@test -f $(STATICLIB_XSLT) || { echo "  FAIL: $(STATICLIB_XSLT) not found; run 'build' first"; exit 1; }
	@test -f $(STATICLIB_EXSLT) || { echo "  FAIL: $(STATICLIB_EXSLT) not found; run 'build' first"; exit 1; }
	$(CC) \
	  -I. -Ilibxslt -Ilibexslt \
	  -I$(BUILDROOT_PATH)/include/libxml2 \
	  -I$(BUILDROOT_PATH)/include \
	  $(TEST_SRC) \
	  -Llibxslt/.libs -Llibexslt/.libs \
	  -L$(BUILDROOT_PATH)/lib \
	  -Wl,-z,noexecstack \
	  -lxslt -lexslt -lxml2 -lz \
	  -o $@

# ===========================================================================
# Install (stage artifacts into release/test output tree)
# ===========================================================================

install: $(STATICLIB_XSLT) $(STATICLIB_EXSLT) $(TEST_ELF)
	@mkdir -p $(LIB_OUT)/pkgconfig $(INCLUDE_OUT)/libxslt $(INCLUDE_OUT)/libexslt $(BIN_OUT) $(TEST_OUT)
	cp -f $(STATICLIB_XSLT)  $(LIB_OUT)/
	cp -f $(STATICLIB_EXSLT) $(LIB_OUT)/
	cp -f libxslt/*.h        $(INCLUDE_OUT)/libxslt/
	cp -f libexslt/*.h       $(INCLUDE_OUT)/libexslt/
	cp -f $(TEST_ELF)        $(TEST_OUT)/
	@echo '#!/bin/sh'                                                               >  $(BIN_OUT)/xslt-config
	@echo 'prefix=$$(CDPATH= cd -- "$$(dirname -- "$$0")/.." && pwd)'              >> $(BIN_OUT)/xslt-config
	@echo 'case "$$1" in'                                                           >> $(BIN_OUT)/xslt-config
	@echo '  --cflags) echo "-I$$prefix/include -I$$prefix/include/libxml2" ;;'     >> $(BIN_OUT)/xslt-config
	@echo '  --libs)   echo "-L$$prefix/lib -lxslt -lxml2 -lz" ;;'                 >> $(BIN_OUT)/xslt-config
	@echo '  --version) echo "1.1.42" ;;'                                           >> $(BIN_OUT)/xslt-config
	@echo 'esac'                                                                    >> $(BIN_OUT)/xslt-config
	chmod +x $(BIN_OUT)/xslt-config
	@echo 'prefix=$${pcfiledir}/../..'                                               >  $(LIB_OUT)/pkgconfig/libxslt.pc
	@echo 'libdir=$${prefix}/lib'                                                   >> $(LIB_OUT)/pkgconfig/libxslt.pc
	@echo 'includedir=$${prefix}/include'                                           >> $(LIB_OUT)/pkgconfig/libxslt.pc
	@echo                                                                          >> $(LIB_OUT)/pkgconfig/libxslt.pc
	@echo 'Name: libxslt'                                                          >> $(LIB_OUT)/pkgconfig/libxslt.pc
	@echo 'Version: 1.1.42'                                                        >> $(LIB_OUT)/pkgconfig/libxslt.pc
	@echo 'Description: XSLT library version 2.'                                   >> $(LIB_OUT)/pkgconfig/libxslt.pc
	@echo 'Libs: -L$${libdir} -lxslt'                                              >> $(LIB_OUT)/pkgconfig/libxslt.pc
	@echo 'Libs.private: -lxml2 -lz -lm'                                           >> $(LIB_OUT)/pkgconfig/libxslt.pc
	@echo 'Cflags: -I$${includedir} -I$${includedir}/libxml2'                      >> $(LIB_OUT)/pkgconfig/libxslt.pc
	@echo 'prefix=$${pcfiledir}/../..'                                               >  $(LIB_OUT)/pkgconfig/libexslt.pc
	@echo 'libdir=$${prefix}/lib'                                                   >> $(LIB_OUT)/pkgconfig/libexslt.pc
	@echo 'includedir=$${prefix}/include'                                           >> $(LIB_OUT)/pkgconfig/libexslt.pc
	@echo                                                                          >> $(LIB_OUT)/pkgconfig/libexslt.pc
	@echo 'Name: libexslt'                                                         >> $(LIB_OUT)/pkgconfig/libexslt.pc
	@echo 'Version: 0.8.23'                                                        >> $(LIB_OUT)/pkgconfig/libexslt.pc
	@echo 'Description: EXSLT Extension library'                                   >> $(LIB_OUT)/pkgconfig/libexslt.pc
	@echo 'Libs: -L$${libdir} -lexslt'                                             >> $(LIB_OUT)/pkgconfig/libexslt.pc
	@echo 'Libs.private: -lxslt -lxml2 -lz -lm'                                    >> $(LIB_OUT)/pkgconfig/libexslt.pc
	@echo 'Cflags: -I$${includedir} -I$${includedir}/libxml2'                      >> $(LIB_OUT)/pkgconfig/libexslt.pc

# ===========================================================================
# Test Targets
# ===========================================================================

test:
	@echo "=== libxslt functional tests ==="
	@test -f $(STATICLIB_XSLT)  || { echo "  FAIL: $(STATICLIB_XSLT) not found";  exit 1; }
	@test -f $(STATICLIB_EXSLT) || { echo "  FAIL: $(STATICLIB_EXSLT) not found"; exit 1; }
	@test -s $(TEST_ELF)        || { echo "  FAIL: $(TEST_ELF) missing or empty"; exit 1; }
	@echo "  OK: build artifacts present (runtime execution is driven by z.py on the host)"
	@echo "=== libxslt functional test prerequisites PASSED ==="

# ===========================================================================
# Clean
# ===========================================================================

clean:
	-$(MAKE) clean 2>/dev/null || true
	rm -f $(TEST_ELF) Makefile
	rm -rf $(OUT_DIR) dist/ libxslt/.libs/ libexslt/.libs/

.PHONY: all install clean test
